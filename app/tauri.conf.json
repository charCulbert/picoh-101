{
  "productName": "PICOH-101",
  "version": "0.1.0",
  "identifier": "com.charlieculbert.picoh101",
  "build": {
    "frontendDist": "loader"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; form-action 'none'; base-uri 'none'; frame-src 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "frameworks": [
        "CoreMIDI"
      ],
      "developmentTeam": "U2G8C755H7"
    }
  }
}
